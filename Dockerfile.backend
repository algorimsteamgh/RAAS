# RAASHiring API / batch worker / migration task (one image, three commands).
#   API:     default CMD (uvicorn)
#   Worker:  python -m backend.app.worker
#   Migrate: python -m backend.app.db.migrate
#   Load:    python -m backend.app.dataload.sqlite_to_postgres --help
# No model runs in this image: AI is Amazon Bedrock (MODEL_BACKEND=bedrock).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000 \
    APP_ENV=production \
    MODEL_BACKEND=bedrock \
    SEED_DEMO_DATA=false \
    AUTO_MIGRATE=false \
    UVICORN_WORKERS=2

WORKDIR /app

# curl is used by the ECS container health check.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY backend/app /app/backend/app
COPY dataset_manifest.json /app/dataset_manifest.json
# Evaluation fixtures (GET /api/evaluation/metrics) and demo seed data
# (used only when SEED_DEMO_DATA=true, never in production).
COPY data/normalized /app/seed_data/normalized
COPY data/evaluation /app/data/evaluation
COPY data/evaluation /app/seed_data/evaluation

RUN useradd --system --uid 10001 --home-dir /app raas \
    && mkdir -p /app/data/cvs/samples /app/data/extracted /app/frontend/dist \
    && chown -R raas:raas /app/data /app/frontend
USER 10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fs http://localhost:${PORT}/healthz || exit 1

CMD ["sh", "-c", "exec uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT} --workers ${UVICORN_WORKERS} --proxy-headers --forwarded-allow-ips='*' --timeout-graceful-shutdown 25"]
